# Salin file ini ke .env dan isi semua nilai sebelum menjalankan aplikasi.
# JANGAN commit file .env ke git.

# === DATABASE ===
POSTGRES_USER=analisabee
POSTGRES_PASSWORD=ganti-password-postgres
POSTGRES_DB=analisabee

# Untuk development lokal (npm run dev):
# DATABASE_URL="postgresql://analisabee:ganti-password-postgres@localhost:5432/analisabee?schema=public"

# === PASSWORD LOGIN (WAJIB) ===
# MASTER: akses penuh termasuk pengaturan sistem
MASTER_PASSWORD=ganti-password-master

# ADMIN: akses baca + import data, tidak bisa ubah pengaturan
# Opsional — hapus jika hanya butuh satu akun master
ADMIN_PASSWORD=ganti-password-admin

# === SESSION SECRET (WAJIB) ===
# Generate dengan: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-hasil-openssl-rand--base64-32

# === PORT (opsional, default 3001) ===
APP_PORT=8080
