# Digunakan oleh docker-compose.yml (deploy) — salin ke .env dan sesuaikan sebelum
# menjalankan `docker compose up -d`. Ganti password default sebelum dipakai serius.
POSTGRES_USER=analisabee
POSTGRES_PASSWORD=analisabee
POSTGRES_DB=analisabee
APP_PORT=3000

# Untuk development lokal (npm run dev) tanpa Docker, isi juga DATABASE_URL berikut
# di file .env terpisah dan arahkan ke Postgres dari docker-compose.dev.yml:
# DATABASE_URL="postgresql://analisabee:analisabee@localhost:5432/analisabee?schema=public"

# Password login berdasarkan role. WAJIB diganti sebelum deploy ke luar jaringan.
# MASTER: akses penuh termasuk pengaturan sistem.
# ADMIN : akses baca + import data, tidak bisa ubah pengaturan.
# (APP_PASSWORD lama masih berfungsi sebagai fallback = master)
MASTER_PASSWORD=ganti-password-master
ADMIN_PASSWORD=ganti-password-admin

# Kunci rahasia untuk menandatangani session cookie login. WAJIB unik per deployment
# dan dirahasiakan. Generate dengan: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-hasil-openssl-rand--base64-32
