# Copy file ini ke .env di server ZimaOS lalu isi nilainya
# JANGAN commit .env ke git

# Password login ke aplikasi AnalisaBEe
APP_PASSWORD=ganti_dengan_password_kuat

# Secret untuk JWT session (min 32 karakter, bisa generate dengan: openssl rand -hex 32)
SESSION_SECRET=ganti_dengan_random_string_panjang

# Password database PostgreSQL
POSTGRES_PASSWORD=ganti_dengan_password_db
